<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <!-- Đặt NGAY SAU ô Tìm kiếm (slot layout-actions chứa SearchBar) —
             user chốt vị trí này thay vì khu pager/refresh bên phải. -->
        <xpath expr="//t[@t-slot='layout-actions']" position="after">
            <div t-if="this.t4FbToggleAvailable and !env.isSmall"
                 class="t4_fb_toggle d-inline-flex align-items-center align-self-center">
                <!-- Style như o_searchview_dropdown_toggler (btn outline có
                     border); đang bật → class active trên CẢ NÚT. -->
                <button class="t4_fb_toggle_btn btn btn-outline-secondary d-print-none"
                        t-att-class="{ active: this.t4FbState.active }"
                        type="button"
                        t-att-title="this.t4FbState.active ? 'Ẩn hàng lọc theo cột' : 'Hiện hàng lọc theo cột'"
                        t-on-click.stop="this.t4FbToggle">
                    <i class="fa fa-filter fa-fw"/>
                </button>
            </div>
        </xpath>
    </t>

</templates>
