<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Body section "date range" (Từ ngày / Đến ngày). Header (icon + tiêu
         đề) do vòng lặp section chuẩn của web.SearchPanelContent render sẵn
         — template này chỉ render phần thân, thế chỗ web.SearchPanel.Section
         khi section.type === 't4_date_range'. -->
    <t t-name="t4_theme.SearchPanelDateRange">
        <div class="o_t4_search_panel_date_range px-2 px-md-0">
            <div class="o_t4_date_range_item mb-2">
                <label class="small text-muted d-block mb-1">Từ ngày</label>
                <DateTimeInput type="'date'"
                               value="t4DateRangeValue(section, 'from')"
                               onApply="(date) => this.onT4DateRangeApply(section, 'from', date)"/>
            </div>
            <div class="o_t4_date_range_item">
                <label class="small text-muted d-block mb-1">Đến ngày</label>
                <DateTimeInput type="'date'"
                               value="t4DateRangeValue(section, 'to')"
                               onApply="(date) => this.onT4DateRangeApply(section, 'to', date)"/>
            </div>
        </div>
    </t>

    <!-- Desktop (Regular kế thừa primary từ SearchPanelContent → nhận luôn
         extension này). -->
    <t t-inherit="web.SearchPanelContent" t-inherit-mode="extension">
        <xpath expr="//t[@t-call='web.SearchPanel.Section']" position="replace">
            <t t-if="section.type === 't4_date_range'" t-call="t4_theme.SearchPanelDateRange"/>
            <t t-else="" t-call="web.SearchPanel.Section"/>
        </xpath>
    </t>

    <!-- Mobile: section nằm trong Dropdown — thay t-call y hệt để không rơi
         vào nhánh filtersGroup (values undefined → crash). -->
    <t t-inherit="web.SearchPanel.Small" t-inherit-mode="extension">
        <xpath expr="//t[@t-call='web.SearchPanel.Section']" position="replace">
            <t t-if="section.type === 't4_date_range'" t-call="t4_theme.SearchPanelDateRange"/>
            <t t-else="" t-call="web.SearchPanel.Section"/>
        </xpath>
    </t>

</templates>
