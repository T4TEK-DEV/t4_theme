<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Tên người dùng trên navbar:
         - Odoo gốc chỉ hiện khi bật debug (`d-none` + `t-att-class` theo env.debug)
           → bỏ điều kiện debug, luôn hiện từ breakpoint lg trở lên.
         - Dòng tên database (`<mark>`) vẫn CHỈ hiện khi bật debug — giữ hành vi cũ.
         - Bố cục do `user_menu.scss` lo: xếp dọc, tên nằm DƯỚI avatar. -->
    <t t-inherit="web.UserMenu" t-inherit-mode="extension">
        <xpath expr="//small[hasclass('oe_topbar_name')]" position="attributes">
            <!-- Bỏ `smaller` (12px) — font-size do user_menu.scss quyết định. -->
            <attribute name="class">oe_topbar_name d-none d-lg-block text-center lh-1 text-truncate</attribute>
            <attribute name="t-att-class"/>
            <attribute name="style"/>
        </xpath>
        <xpath expr="//small[hasclass('oe_topbar_name')]/mark" position="attributes">
            <attribute name="t-if">env.debug</attribute>
        </xpath>
    </t>

</templates>
